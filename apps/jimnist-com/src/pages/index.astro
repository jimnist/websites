---
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelSmiley from '../components/PixelSmiley.astro';
---

<BaseLayout title="jimnist">
  <PixelSmiley />
  <!-- Category links under the face. Plain text so they never compete with the
       smiley, which is the point of this page. New categories (artwork,
       furniture) get added here as their pages land. -->
  <nav class="links">
    <a href="/software">software</a>
  </nav>
</BaseLayout>

<style>
  :global(body) {
    background-color: #fffcf0;
  }

  .links {
    width: 90vmin;
    max-width: 500px;
    margin: 2.5vmin auto 4rem;
    display: flex;
    justify-content: center;
    gap: 1.75rem;
    font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI',
      Roboto, Helvetica, Arial, sans-serif;
    font-size: 1rem;
    letter-spacing: 0.02em;
  }

  .links a {
    color: #8a7f6a;
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
  }

  .links a:hover,
  .links a:focus-visible {
    color: #241f16;
    border-bottom-color: #ffd84d;
  }
</style>
