---
import { yellows, lefts, rights } from '../data/pixels';

const PIXEL_SIZE = 20;
const GRID_SIZE = 19; // Face uses 0-18, not 0-19
const VIEW_SIZE = PIXEL_SIZE * GRID_SIZE; // 380
const BORDER_COLOR = '#dedede'; // Same as background
const OUTER_EDGE_COLOR = '#dedede'; // Same as background
const VIEWBOX_PADDING = 1; // 1px margin so outer border lines aren't clipped

// Eye positions in grid coordinates (shifted by 1 to match original half_pixel offset)
const LEFT_EYE_X = 4;
const LEFT_EYE_Y = 6;
const RIGHT_EYE_X = 12;
const RIGHT_EYE_Y = 6;

// The nose bridge: the single grid cell midway between the two eye blocks.
// Dwelling here triggers the dance easter egg. See docs/specs/dance-easter-egg.md.
const NOSE_BRIDGE_X = 9;
const NOSE_BRIDGE_Y = 7;

// Dance timing. The dance recolors the fixed squares DDR-style - nothing
// in the face ever moves. When the `dancing` class lands, the face snaps
// into a random neon mosaic (one palette color per 2x2 block, shaded per
// pixel), and a single 2x2 roamer block of a distinct color random-walks
// across the mosaic, hopping to an adjacent block on every beat. All of
// it is precomputed at build time and driven by CSS; the client script
// only toggles the class on and off.
const BPM = 130;
const BEAT_MS = 60000 / BPM; // ~461.5ms
const ROUTINE_BEATS = 16; // 4 bars x 4 beats
const ROUTINE_MS = Math.round(BEAT_MS * ROUTINE_BEATS); // ~7.4s

const NEON_PALETTE = ['#ff2d95', '#00e5ff', '#39ff14', '#b026ff', '#ffe814'];
const ROAMER_COLOR = '#ffffff'; // the one color that roams - tune by eye
const ROAMER_SEED = 20260730; // deterministic walk; change to reroll it

// Deterministic per-block randomness for the mosaic (GLSL-style sin hash -
// scatters well, no visible diagonals).
function blockHash(bx: number, by: number): number {
  const h = Math.sin(bx * 127.1 + by * 311.7) * 43758.5453;
  return h - Math.floor(h); // 0..1
}

function blockOf(gx: number, gy: number): { bx: number; by: number } {
  return { bx: Math.floor(gx / 2), by: Math.floor(gy / 2) };
}

// Per-pixel shading preserves the face's original light/dark structure as
// a neon relief: the block's palette color sits mid-range, the darkest
// pixels push it toward black and the lightest toward white. All mixing
// happens here at build time, so the CSS needs no color-mix() support.
function hexLuma(hex: string): number {
  const h = hex.length === 4
    ? hex.slice(1).split('').map(c => c + c).join('')
    : hex.slice(1);
  const r = parseInt(h.slice(0, 2), 16) / 255;
  const g = parseInt(h.slice(2, 4), 16) / 255;
  const b = parseInt(h.slice(4, 6), 16) / 255;
  return 0.299 * r + 0.587 * g + 0.114 * b; // rec.601 grayscale
}

const faceLumas = yellows.map(p => hexLuma(p.c));
const lumaMin = Math.min(...faceLumas);
const lumaMax = Math.max(...faceLumas);

const MAX_DARK = 50; // % toward black for the darkest pixel - tune by eye
const MAX_LIFT = 70; // % toward white for the lightest pixel - tune by eye

// Channel-wise mix of a hex color toward a target (t in 0..1).
function mixHex(hex: string, target: [number, number, number], t: number): string {
  const h = hex.length === 4
    ? hex.slice(1).split('').map(c => c + c).join('')
    : hex.slice(1);
  const mix = (i: number) => {
    const v = parseInt(h.slice(i * 2, i * 2 + 2), 16);
    return Math.round(v + (target[i] - v) * t).toString(16).padStart(2, '0');
  };
  return `#${mix(0)}${mix(1)}${mix(2)}`;
}

// The mosaic color a pixel shows while dancing: its block's random palette
// pick, shaded by the pixel's own original grayscale value.
function mosaicColor(gx: number, gy: number, originalColor: string): string {
  const { bx, by } = blockOf(gx, gy);
  const base = NEON_PALETTE[Math.floor(blockHash(bx, by) * NEON_PALETTE.length)];
  const luma = hexLuma(originalColor);
  const t = lumaMax > lumaMin ? (luma - lumaMin) / (lumaMax - lumaMin) : 0;
  const shade = t * (MAX_DARK + MAX_LIFT) - MAX_DARK; // -MAX_DARK..+MAX_LIFT
  return shade < 0
    ? mixHex(base, [0, 0, 0], -shade / 100)
    : mixHex(base, [255, 255, 255], shade / 100);
}

// --- The roamer: a seeded random walk over the face, one hop per beat ---

// A block is walkable when all four of its cells are face pixels - this
// automatically excludes the eye regions (their cells live in lefts/rights,
// not yellows) and any block hanging off the face's edge.
const walkable = new Set<string>();
{
  const cell = new Set(yellows.map(p => `${p.x},${p.y}`));
  for (let bx = 0; bx < Math.ceil(GRID_SIZE / 2); bx++) {
    for (let by = 0; by < Math.ceil(GRID_SIZE / 2); by++) {
      if (
        cell.has(`${bx * 2},${by * 2}`) &&
        cell.has(`${bx * 2 + 1},${by * 2}`) &&
        cell.has(`${bx * 2},${by * 2 + 1}`) &&
        cell.has(`${bx * 2 + 1},${by * 2 + 1}`)
      ) {
        walkable.add(`${bx},${by}`);
      }
    }
  }
}

// Small deterministic PRNG (mulberry32) so the walk is stable per build.
function mulberry32(seed: number): () => number {
  let a = seed;
  return () => {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// Random walk: start on the nose-bridge block, hop to a walkable neighbor
// each beat, avoiding an immediate backtrack when any other option exists.
const roamerPath: { bx: number; by: number }[] = [];
{
  const rand = mulberry32(ROAMER_SEED);
  let cur = blockOf(NOSE_BRIDGE_X, NOSE_BRIDGE_Y);
  let prev: { bx: number; by: number } | null = null;
  roamerPath.push(cur);
  for (let i = 0; i < ROUTINE_BEATS; i++) {
    const neighbors = [
      { bx: cur.bx + 1, by: cur.by },
      { bx: cur.bx - 1, by: cur.by },
      { bx: cur.bx, by: cur.by + 1 },
      { bx: cur.bx, by: cur.by - 1 },
    ].filter(b => walkable.has(`${b.bx},${b.by}`));
    let options = neighbors.filter(b => !prev || b.bx !== prev.bx || b.by !== prev.by);
    if (options.length === 0) options = neighbors;
    const next = options[Math.floor(rand() * options.length)];
    roamerPath.push(next);
    prev = cur;
    cur = next;
  }
}

// The walk as a CSS keyframes rule: one stop per beat, discrete hops via
// steps(1, end). Injected as a global style because Astro scopes keyframe
// names inside its scoped <style> blocks.
const BLOCK_PX = PIXEL_SIZE * 2;
const roamerStops = roamerPath
  .map((b, i) => {
    const pct = ((i / (roamerPath.length - 1)) * 100).toFixed(2);
    return `${pct}% { transform: translate(${b.bx * BLOCK_PX}px, ${b.by * BLOCK_PX}px); }`;
  })
  .join('\n  ');

const roamerCss = `
@keyframes jimnist-roam {
  ${roamerStops}
}
#rave-roamer {
  visibility: hidden;
}
#smiley-svg.dancing #rave-roamer {
  visibility: visible;
  animation: jimnist-roam ${ROUTINE_MS}ms steps(1, end) both;
}
@media (prefers-reduced-motion: reduce) {
  #smiley-svg.dancing #rave-roamer {
    visibility: hidden;
  }
}
`;

// Build pixel set for border calculation
const yellowSet = new Set<string>();
yellows.forEach(p => yellowSet.add(`${p.x},${p.y}`));

// Calculate borders - outer edges get darker color
function getBorders(pixels: {x: number, y: number, c: string}[], pixelSet: Set<string>) {
  const lines: {x1: number, y1: number, x2: number, y2: number, color: string}[] = [];
  const drawn = new Set<string>();

  pixels.forEach(p => {
    const px = p.x * PIXEL_SIZE;
    const py = p.y * PIXEL_SIZE;

    // Top edge
    const topKey = `h:${p.x},${p.y}`;
    if (!drawn.has(topKey)) {
      const hasTopNeighbor = pixelSet.has(`${p.x},${p.y - 1}`);
      lines.push({x1: px, y1: py, x2: px + PIXEL_SIZE, y2: py, color: hasTopNeighbor ? BORDER_COLOR : OUTER_EDGE_COLOR});
      drawn.add(topKey);
    }

    // Right edge
    const rightKey = `v:${p.x + 1},${p.y}`;
    if (!drawn.has(rightKey)) {
      const hasRightNeighbor = pixelSet.has(`${p.x + 1},${p.y}`);
      lines.push({x1: px + PIXEL_SIZE, y1: py, x2: px + PIXEL_SIZE, y2: py + PIXEL_SIZE, color: hasRightNeighbor ? BORDER_COLOR : OUTER_EDGE_COLOR});
      drawn.add(rightKey);
    }

    // Bottom edge
    const bottomKey = `h:${p.x},${p.y + 1}`;
    if (!drawn.has(bottomKey)) {
      const hasBottomNeighbor = pixelSet.has(`${p.x},${p.y + 1}`);
      lines.push({x1: px, y1: py + PIXEL_SIZE, x2: px + PIXEL_SIZE, y2: py + PIXEL_SIZE, color: hasBottomNeighbor ? BORDER_COLOR : OUTER_EDGE_COLOR});
      drawn.add(bottomKey);
    }

    // Left edge
    const leftKey = `v:${p.x},${p.y}`;
    if (!drawn.has(leftKey)) {
      const hasLeftNeighbor = pixelSet.has(`${p.x - 1},${p.y}`);
      lines.push({x1: px, y1: py, x2: px, y2: py + PIXEL_SIZE, color: hasLeftNeighbor ? BORDER_COLOR : OUTER_EDGE_COLOR});
      drawn.add(leftKey);
    }
  });

  return lines;
}

const yellowBorders = getBorders(yellows, yellowSet);

// Eye borders - all outer since eyes are separate groups
const leftSet = new Set<string>();
lefts.forEach(p => leftSet.add(`${p.x},${p.y}`));
const leftBorders = getBorders(lefts, leftSet);

const rightSet = new Set<string>();
rights.forEach(p => rightSet.add(`${p.x},${p.y}`));
const rightBorders = getBorders(rights, rightSet);
---

<div class="smiley-container">
  <svg
    id="smiley-svg"
    viewBox={`-${VIEWBOX_PADDING} -${VIEWBOX_PADDING} ${VIEW_SIZE + VIEWBOX_PADDING * 2} ${VIEW_SIZE + VIEWBOX_PADDING * 2}`}
    data-viewbox-padding={VIEWBOX_PADDING}
    data-routine-ms={ROUTINE_MS}
  >
    <!-- Face pixels (no stroke). The squares never move; while dancing,
         each shows its precomputed mosaic color (block's random palette
         pick, shaded by the pixel's own original grayscale value). -->
    {yellows.map(p => (
      <rect
        class="pixel rave"
        style={`--rave-bg: ${mosaicColor(p.x, p.y, p.c)}`}
        x={p.x * PIXEL_SIZE}
        y={p.y * PIXEL_SIZE}
        width={PIXEL_SIZE}
        height={PIXEL_SIZE}
        fill={p.c}
      />
    ))}

    <!-- The roamer: one 2x2 block that random-walks the mosaic on the
         beat while dancing (path precomputed at build time - see the
         injected jimnist-roam keyframes). Drawn before the border lines
         so the grid renders over it, and before the eyes and signature
         so it passes behind them. -->
    <rect
      id="rave-roamer"
      x="0"
      y="0"
      width={PIXEL_SIZE * 2}
      height={PIXEL_SIZE * 2}
      fill={ROAMER_COLOR}
    />

    <!-- Face borders -->
    {yellowBorders.map(l => (
      <line
        x1={l.x1}
        y1={l.y1}
        x2={l.x2}
        y2={l.y2}
        stroke={l.color}
        stroke-width="1"
      />
    ))}

    <!-- Left eye group -->
    <g id="left-eye" transform={`translate(${LEFT_EYE_X * PIXEL_SIZE}, ${LEFT_EYE_Y * PIXEL_SIZE})`}>
      <!-- Eye whites carry no rave track: they sit out the dance so the
           eyes stay readable through the confetti. -->
      {lefts.map(p => (
        <rect
          class="pixel"
          x={p.x * PIXEL_SIZE}
          y={p.y * PIXEL_SIZE}
          width={PIXEL_SIZE}
          height={PIXEL_SIZE}
          fill={p.c}
        />
      ))}
      {leftBorders.map(l => (
        <line
          x1={l.x1}
          y1={l.y1}
          x2={l.x2}
          y2={l.y2}
          stroke={l.color}
          stroke-width="1"
        />
      ))}
      <rect
        id="left-pupil"
        class="pupil"
        x={PIXEL_SIZE * 0.75}
        y={PIXEL_SIZE * 0.75}
        width={PIXEL_SIZE * 1.5}
        height={PIXEL_SIZE * 1.5}
        fill="#111111"
      />
    </g>

    <!-- Right eye group -->
    <g id="right-eye" transform={`translate(${RIGHT_EYE_X * PIXEL_SIZE}, ${RIGHT_EYE_Y * PIXEL_SIZE})`}>
      <!-- Eye whites carry no rave track: they sit out the dance so the
           eyes stay readable through the confetti. -->
      {rights.map(p => (
        <rect
          class="pixel"
          x={p.x * PIXEL_SIZE}
          y={p.y * PIXEL_SIZE}
          width={PIXEL_SIZE}
          height={PIXEL_SIZE}
          fill={p.c}
        />
      ))}
      {rightBorders.map(l => (
        <line
          x1={l.x1}
          y1={l.y1}
          x2={l.x2}
          y2={l.y2}
          stroke={l.color}
          stroke-width="1"
        />
      ))}
      <rect
        id="right-pupil"
        class="pupil"
        x={PIXEL_SIZE * 0.75}
        y={PIXEL_SIZE * 0.75}
        width={PIXEL_SIZE * 1.5}
        height={PIXEL_SIZE * 1.5}
        fill="#222222"
      />
    </g>

    <!-- Logo image -->
    <image href="/img/big_jim.png" x="87" y="240" width="205" height="55" />

    <!-- Nose bridge hotspot: dwelling/long-pressing here triggers the dance.
         Invisible on purpose - see docs/specs/dance-easter-egg.md. -->
    <rect
      id="nose-bridge-hotspot"
      x={NOSE_BRIDGE_X * PIXEL_SIZE}
      y={NOSE_BRIDGE_Y * PIXEL_SIZE}
      width={PIXEL_SIZE}
      height={PIXEL_SIZE}
      fill="transparent"
    />
  </svg>
</div>

<!-- Build-time-generated roamer walk (global: Astro scopes keyframe names
     inside its scoped style blocks, so the walk lives here instead). -->
<Fragment set:html={`<style>${roamerCss}</style>`} />

<script>
  const PIXEL_SIZE = 20;
  const EYE_SIZE = PIXEL_SIZE * 3; // 60px - the 3x3 eye grid
  const PUPIL_BASE = PIXEL_SIZE * 0.75; // 15px - centered position

  // Max offset: pupil can move from 0 to (EYE_SIZE - PUPIL_SIZE) = 30
  // Base position is 15, so max offset is 15 in any direction
  const MAX_OFFSET = PIXEL_SIZE * 0.75; // 15px - keeps pupil inside eye

  const svgEl = document.getElementById('smiley-svg');
  const VIEWBOX_PADDING = parseFloat(svgEl?.dataset.viewboxPadding || '0');
  const ROUTINE_MS = parseFloat(svgEl?.dataset.routineMs || '7400');
  const VIEW_SIZE = PIXEL_SIZE * 19; // 380
  const VIEWBOX_SIZE = VIEW_SIZE + VIEWBOX_PADDING * 2;

  function getBaseTranslate(el: Element | null): { x: number; y: number } {
    const t = el?.getAttribute('transform') || '';
    const match = t.match(/translate\(([-\d.]+),\s*([-\d.]+)\)/);
    return match ? { x: parseFloat(match[1]), y: parseFloat(match[2]) } : { x: 0, y: 0 };
  }

  function updatePupils(mouseX: number, mouseY: number) {
    if (!svgEl) return;

    const svgRect = svgEl.getBoundingClientRect();
    const scale = svgRect.width / VIEWBOX_SIZE;

    ['left', 'right'].forEach(side => {
      const eye = document.getElementById(`${side}-eye`);
      const pupil = document.getElementById(`${side}-pupil`);
      if (!eye || !pupil) return;

      const { x: eyeX, y: eyeY } = getBaseTranslate(eye);

      // Calculate eye center in page coordinates (center of 3x3 grid).
      // The viewBox origin is (-VIEWBOX_PADDING, -VIEWBOX_PADDING), so a
      // raw grid coordinate maps to screen position offset by that padding.
      const eyeCenterX = svgRect.left + (eyeX + EYE_SIZE / 2 + VIEWBOX_PADDING) * scale;
      const eyeCenterY = svgRect.top + (eyeY + EYE_SIZE / 2 + VIEWBOX_PADDING) * scale;

      // Calculate direction to mouse
      const dx = mouseX - eyeCenterX;
      const dy = mouseY - eyeCenterY;
      const distance = Math.sqrt(dx * dx + dy * dy);

      // Normalize and constrain movement
      let offsetX = 0;
      let offsetY = 0;
      if (distance > 0) {
        // Scale the offset based on distance, but cap at MAX_OFFSET
        const scaledOffset = Math.min(MAX_OFFSET, distance / scale);
        offsetX = (dx / distance) * scaledOffset;
        offsetY = (dy / distance) * scaledOffset;
      }

      // Position pupil - base position centers the 30px pupil in 60px eye
      pupil.setAttribute('x', (PUPIL_BASE + offsetX).toString());
      pupil.setAttribute('y', (PUPIL_BASE + offsetY).toString());
    });
  }

  document.addEventListener('mousemove', (e) => {
    updatePupils(e.clientX, e.clientY);
  });

  // --- Dance easter egg -----------------------------------------------
  // Dwelling (mouse) or long-pressing (touch) the nose bridge hotspot for
  // 1s starts the dance: a neon color wave that flows outward across the
  // fixed squares from the nose bridge. The animation itself is pure CSS
  // (see the `dancing` styles below); this script only adds the class and
  // removes it when the routine ends, so there is no animation loop that
  // can fail mid-flight. Removing the class restores the original colors
  // automatically because the fill attributes are never touched.
  // See docs/specs/dance-easter-egg.md.

  const DWELL_MS = 1000;

  const hotspot = document.getElementById('nose-bridge-hotspot');

  let danceRunning = false;
  let danceEndTimeout: number | null = null;

  function startDance() {
    if (danceRunning) return;
    danceRunning = true;
    svgEl?.classList.add('dancing');
    danceEndTimeout = window.setTimeout(endDance, ROUTINE_MS);
  }

  function endDance() {
    if (danceEndTimeout !== null) {
      clearTimeout(danceEndTimeout);
      danceEndTimeout = null;
    }
    svgEl?.classList.remove('dancing');
    danceRunning = false;
  }

  // Keyed by pointerId so independent pointers (e.g. two touches on the tiny
  // hotspot at once) can't cancel each other's dwell.
  const dwellTimers = new Map<number, number>();

  function armDwell(pointerId: number) {
    if (danceRunning || dwellTimers.has(pointerId)) return;
    const handle = window.setTimeout(() => {
      dwellTimers.delete(pointerId);
      startDance();
    }, DWELL_MS);
    dwellTimers.set(pointerId, handle);
  }

  function disarmDwell(pointerId: number) {
    const handle = dwellTimers.get(pointerId);
    if (handle !== undefined) {
      clearTimeout(handle);
      dwellTimers.delete(pointerId);
    }
  }

  if (hotspot) {
    hotspot.addEventListener('pointerenter', (e: PointerEvent) => {
      if (e.pointerType === 'mouse' || e.pointerType === 'pen') armDwell(e.pointerId);
    });
    hotspot.addEventListener('pointerleave', (e: PointerEvent) => {
      // Touch dwell is only canceled by lifting the finger (pointerup) or a
      // gesture takeover (pointercancel) - ordinary jitter off the tiny
      // hit-box must not reset it (see docs/specs/dance-easter-egg.md).
      if (e.pointerType === 'touch') return;
      disarmDwell(e.pointerId);
    });
    hotspot.addEventListener('pointerdown', (e: PointerEvent) => {
      if (e.pointerType === 'touch') {
        e.preventDefault();
        hotspot.setPointerCapture(e.pointerId);
        armDwell(e.pointerId);
      }
    });
    hotspot.addEventListener('pointerup', (e: PointerEvent) => {
      if (e.pointerType === 'touch') disarmDwell(e.pointerId);
    });
    hotspot.addEventListener('pointercancel', (e: PointerEvent) => disarmDwell(e.pointerId));
  }
  // --- end dance easter egg --------------------------------------------
</script>

<style>
  .smiley-container {
    width: 90vmin;
    max-width: 500px;
    margin: 5vmin auto 0;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .pupil {
    pointer-events: none;
  }

  #nose-bridge-hotspot {
    touch-action: none;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }

  /* The dance: DDR-style beat-locked confetti across the fixed squares.
     While `dancing` is set, every pixel snaps between the neon colors
     exactly on the beat - steps() holds each color for a full beat, then
     cuts with no blend, like an arcade cabinet's flashing panels. Each
     pixel's --rave-phase (a random whole number of beats, hashed from its
     coordinates at build time) plus one of two palette orders scatters the
     colors so neighbors rarely match: chaos in space, unity in time.
     Negative delay = every pixel is already mid-cycle when the class
     lands, so the strobe hits the whole face instantly. CSS `fill`
     overrides the SVG fill attribute, so removing the class restores
     every original color with no bookkeeping. */
  /* The mosaic: while dancing, each face pixel shows its precomputed
     --rave-bg (block's random palette color, shaded by the pixel's own
     grayscale value). A static CSS override - no animation, and removing
     the class restores the fill attribute with no bookkeeping. Only
     squares carrying the rave class change; the eye whites have none, so
     they sit out and the eyes stay readable. The motion is the roamer -
     see the injected jimnist-roam keyframes. */
  #smiley-svg.dancing .rave {
    fill: var(--rave-bg);
  }

  /* Calm variant: under prefers-reduced-motion the mosaic crossfades in
     and out gently instead of snapping (the roamer is hidden - see the
     injected roamer style). */
  @media (prefers-reduced-motion: reduce) {
    .rave {
      transition: fill 800ms ease-in-out;
    }
  }
</style>
